{
  "name": "akash-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "check:main-cms-push": "node scripts/check-main-cms-push.mjs",
    "attach:pcb-depth": "node scripts/attach-pcb-depth-definition.mjs",
    "compile:pcb-derivatives": "node --experimental-strip-types scripts/compile-pcb-derivatives.mjs",
    "benchmark:pcb-derivatives": "node --experimental-strip-types scripts/pcb-full-layout-benchmark.mjs",
    "benchmark:pcb-shared-definitions": "node --experimental-strip-types scripts/pcb-shared-definitions-benchmark.mjs",
    "benchmark:pcb-browser-cost": "node --experimental-strip-types scripts/pcb-browser-cost-benchmark.mjs",
    "test:pcb-touch-svg": "node --experimental-strip-types --test prototypes/pcb-touch-native-svg/model.test.mjs prototypes/pcb-touch-native-svg/geometry.test.mjs scripts/pcb-touch-integration.test.mjs scripts/pcb-touch-preparation.test.mjs",
    "verify:pcb-touch-svg": "npm run test:pcb-touch-svg && node --experimental-strip-types scripts/verify-pcb-touch-native-svg.mjs && node scripts/verify-pcb-touch-halo.mjs",
    "verify:pcb-derivative-render": "node --experimental-strip-types scripts/verify-pcb-derivative-render.mjs",
    "prepare:pcb-background": "node scripts/prepare-pcb-background.mjs",
    "prepare:pcb-native": "node scripts/build-pcb-native.mjs",
    "prepare": "node scripts/build-pcb-native.mjs",
    "dev": "node scripts/dev-with-pcb-native.mjs",
    "build": "node scripts/build-pcb-native.mjs && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.4.6",
    "react": "latest",
    "react-dom": "latest",
    "resend": "latest",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "0.28.2",
    "typescript": "latest"
  }
}
